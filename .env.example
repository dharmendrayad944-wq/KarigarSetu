# KarigarSetu Environment Configuration
# ====================================

# Demo mode: When true, deterministic high-fidelity AI and storage mocks are used
# No external paid API keys required to demonstrate the full application!
NEXT_PUBLIC_DEMO_MODE=true

# Google Gemini API Key (Optional in DEMO_MODE, recommended for production multimodal listing)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Supabase Credentials (Optional in DEMO_MODE; in-memory/browser repository used when blank)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
